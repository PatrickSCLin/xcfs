{
 "name": "Element X iOS (arm64, zero-config)",
 "description": "https://github.com/element-hq/element-x-ios: a project generated by XcodeGen (committed), one large app target, local and remote Swift packages and a prebuilt Rust SDK; not seen while xcfs was developed.",
 "agents": 3,
 "plain": {
  "create": [
   "git worktree add -q -b {branch} {dest}"
  ],
  "build": "xcodebuild build -project ElementX.xcodeproj -scheme 'ElementX' -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO ARCHS=arm64",
  "remove": "git worktree remove --force {dest} && git branch -D {branch}"
 },
 "edits": [
  {
   "name": "edit a function body in the app target",
   "file": "ElementX/Sources/Services/SecureBackup/SecureBackupController.swift",
   "find": "        MXLog.info(\"Generating recovery key\")",
   "replace": "        _ = {n}\n        MXLog.info(\"Generating recovery key\")"
  },
  {
   "name": "edit a function body in a package 240 files import (Compound)",
   "file": "compound-ios/Sources/Compound/BaseStyles/CompoundButtonStyle.swift",
   "find": "        guard isEnabled else { return .compound.bgActionPrimaryDisabled }",
   "replace": "        _ = {n}\n        guard isEnabled else { return .compound.bgActionPrimaryDisabled }"
  },
  {
   "name": "add a public declaration to that package",
   "file": "compound-ios/Sources/Compound/BaseStyles/CompoundButtonStyle.swift",
   "append": "\npublic func xcfsBenchDeclaration{n}() -> Int { {n} }\n"
  }
 ],
 "editRepeats": 2,
 "roundEdits": 5,
 "xcfs": {
  "config": {
   "version": 1,
   "toolchains": [
    {
     "adapter": "xcode",
     "project": "ElementX.xcodeproj",
     "scheme": "ElementX",
     "configurations": {
      "sim-debug": {
       "configuration": "Debug",
       "destination": "generic/platform=iOS Simulator"
      }
     },
     "buildSettings": {
      "CODE_SIGNING_ALLOWED": "NO",
      "ARCHS": "arm64"
     }
    }
   ]
  },
  "variants": {
   "defaults": {},
   "defaults-without-driver-patch": {
    "swiftDriver": "native"
   }
  },
  "measureCheck": true
 }
}