#!/usr/bin/env python3
"""xcfs entry point. The code lives in ../lib/xcfs (or ../libexec/xcfs when installed by a package manager)."""
import os, sys

here = os.path.dirname(os.path.realpath(__file__))
for lib in (os.path.join(here, "..", "lib"), os.path.join(here, "..", "libexec")):
    if os.path.isdir(os.path.join(lib, "xcfs")):
        sys.path.insert(0, os.path.realpath(lib))
        break

from xcfs.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
