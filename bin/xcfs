#!/usr/bin/env python3
"""xcfs — worktree and build-cache lifecycle for parallel (agent) development on macOS.

  xcfs new <repo> <branch> [dest] [--from REF] [--session ID]   worktree + clonefile-seeded dependency layer
  xcfs rm <worktree> [--apply] [--discard-ignored] [--prune-branch]   remove a worktree and every cache it owns
  xcfs reap [--session ID | --older-than DAYS | --all] [--apply] [--prune-branch]
                                                                remove the CLEAN worktrees of a session / of that age
  xcfs adopt <worktree> [--session ID | --release]              hand a worktree to a session, take one made with plain
                                                                `git worktree add` under management, or exempt it from reap
  xcfs gc [--apply] [--foreign] [--stale-days N]                reclaim what xcfs owns; --foreign also looks at global DerivedData
  xcfs ls [--session ID] [--status] [--sizes]                   worktrees xcfs manages (--status: dirty files, unpushed commits, age)
  xcfs doctor [path]                                            environment and hygiene checks
  xcfs trust <repo>                                             approve the commands a repo's config wants to run

Every command takes --json. Nothing is deleted without --apply.

The session id comes from --session, else $XCFS_SESSION, else $CLAUDE_CODE_SESSION_ID. An agent session that ends runs
    xcfs reap --session <id> --apply --prune-branch
which removes every worktree the session made that holds no uncommitted work (commits stay on their branches; a branch
xcfs created that never got a commit is deleted with --prune-branch) and reports the ones it had to leave.

Project knowledge lives in a config, never in this file: <repo>/.xcfs.json, else
$XDG_CONFIG_HOME/xcfs/<repo basename>.json:
  { "version": 1,
    "seed": [".spm_cache", "Pods"],          dependency dirs cloned (APFS clonefile) into a new worktree
    "carry": ["local.xcconfig"],             ignored files copied into a new worktree
    "afterSeed": ["rm -rf .spm_cache/x"],    commands run in the new worktree (needs `xcfs trust`)
    "pinDerivedData": true }                 make Xcode.app keep DerivedData inside the worktree

Exit codes: 0 ok · 1 error · 2 usage · 3 config not trusted · 4 not one APFS volume · 5 uncommitted work
            6 in use · 7 ignored files would be lost

State lives in $XCFS_STATE, else $XDG_STATE_HOME/xcfs, else ~/.local/state/xcfs. The DerivedData root that rm and
gc look at is $XCFS_DD_ROOT, else ~/Library/Developer/Xcode/DerivedData.
"""
import contextlib, fcntl, hashlib, json, os, plistlib, re, shutil, subprocess, sys, time

HOME = os.path.expanduser("~")
STATE = os.environ.get("XCFS_STATE") or os.path.join(os.environ.get("XDG_STATE_HOME") or HOME + "/.local/state", "xcfs")
CONFIG_HOME = os.path.join(os.environ.get("XDG_CONFIG_HOME") or HOME + "/.config", "xcfs")
DD_ROOT = os.environ.get("XCFS_DD_ROOT") or HOME + "/Library/Developer/Xcode/DerivedData"
TRASH = ".xcfs-trash"
JSON_OUT = False
RESULT = {}


class Fail(Exception):
    def __init__(self, msg, code=1):
        super().__init__(msg); self.code = code


def say(msg=""):
    if not JSON_OUT:
        print(msg, flush=True)


def phys(p):
    """Physical path. Xcode and git record physical paths; a logical one (through a symlink) never matches them."""
    return os.path.realpath(os.path.expanduser(p))


def under(path, root):
    """path is root or inside it — on a path boundary, so /a/wt-foo does not own /a/wt-foobar."""
    return path == root or path.startswith(root.rstrip("/") + "/")


def session_of(a):
    return a.opt.get("session") or os.environ.get("XCFS_SESSION") or os.environ.get("CLAUDE_CODE_SESSION_ID", "")


def run(*cmd, cwd=None, check=True, env=None, timeout=None):
    r = subprocess.run(list(cmd), cwd=cwd, capture_output=True, text=True, env=env, timeout=timeout)
    if check and r.returncode != 0:
        raise Fail("%s failed: %s" % (" ".join(cmd[:4]), (r.stderr or r.stdout).strip()[:400]))
    return r


def git(repo, *args, check=True):
    return run("git", "-C", repo, *args, check=check).stdout.strip()


def human(kb):
    return "%.1fG" % (kb / 1048576) if kb >= 1048576 else "%.0fM" % (kb / 1024) if kb >= 1024 else "%dK" % kb


def du_kb(path):
    r = run("du", "-sk", path, check=False).stdout.split()
    return int(r[0]) if r and r[0].isdigit() else 0


# ------------------------------------------------------------------ registry
@contextlib.contextmanager
def registry(write=True):
    """All state changes happen under one file lock; the file is replaced atomically."""
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "registry.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = os.path.join(STATE, "registry.json")
        try:
            reg = json.load(open(path))
        except (FileNotFoundError, ValueError):
            reg = {"version": 1, "worktrees": {}}
        yield reg
        if write:
            tmp = path + ".%d.tmp" % os.getpid()
            json.dump(reg, open(tmp, "w"), indent=1)
            os.replace(tmp, path)


@contextlib.contextmanager
def repo_lock(repo):
    """git's worktree bookkeeping is not safe against itself: two `worktree add` (or `prune`) in one repository at the
    same moment fail now and then ("failed to read .git/worktrees/…/commondir", "Invalid path '.git/worktrees'";
    measured 3 failures in 14 runs of 8 parallel calls). Every such call goes through this per-repository lock."""
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "repo-%s.lock" % hashlib.sha256(repo.encode()).hexdigest()[:16]), "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def load_config(repo):
    for p in (os.path.join(repo, ".xcfs.json"), os.path.join(CONFIG_HOME, os.path.basename(repo) + ".json")):
        if os.path.isfile(p):
            try:
                cfg = json.load(open(p))
            except ValueError as e:
                raise Fail("config %s is not valid JSON: %s" % (p, e))
            if cfg.get("version", 1) != 1:
                raise Fail("config %s has version %s; this xcfs reads version 1" % (p, cfg.get("version")))
            cfg["_path"] = p
            return cfg
    return {"_path": None}


def trust_key(repo, cfg):
    return hashlib.sha256((repo + "\n" + json.dumps(cfg.get("afterSeed", []))).encode()).hexdigest()


def is_trusted(repo, cfg):
    try:
        return trust_key(repo, cfg) in json.load(open(os.path.join(STATE, "trust.json")))
    except (FileNotFoundError, ValueError):
        return False


# --------------------------------------------------------------------- new
def fs_type(path):
    """Filesystem type name of the volume holding path ("apfs", "hfs", …), from statfs(2)."""
    import ctypes
    libc = ctypes.CDLL(None, use_errno=True)
    try:  # on x86_64 the plain symbol is the legacy 32-bit-inode struct with another layout; arm64 has only one
        statfs = libc["statfs$INODE64"]
    except AttributeError:
        statfs = libc.statfs
    buf = ctypes.create_string_buffer(4096)
    if statfs(os.fsencode(path), buf) != 0:
        return ""
    return buf.raw[72:88].split(b"\0")[0].decode()   # struct statfs.f_fstypename (64-bit-inode layout)


def rewrite_paths(root, old, new):
    """SwiftPM's workspace-state.json records absolute paths. Rewrite them as JSON string values, matching `old`
    only as a whole path prefix (never as a regex, never inside a longer sibling name)."""
    pat = re.compile(re.escape(old) + r"(?=/|$)")
    n = 0

    def walk(v):
        nonlocal n
        if isinstance(v, str):
            v2, k = pat.subn(lambda m: new, v); n += k; return v2
        if isinstance(v, list):
            return [walk(x) for x in v]
        if isinstance(v, dict):
            return {k: walk(x) for k, x in v.items()}
        return v
    for d in (root, os.path.join(root, ".build")):
        f = os.path.join(d, "workspace-state.json")
        if os.path.isfile(f):
            try:
                data = json.load(open(f))
            except ValueError:
                continue
            data = walk(data)
            tmp = f + ".xcfs.tmp"; json.dump(data, open(tmp, "w"), indent=2); os.replace(tmp, f)
    return n


def pin_derived_data(ws):
    f = os.path.join(ws, "xcuserdata", os.environ.get("USER", "user") + ".xcuserdatad", "WorkspaceSettings.xcsettings")
    os.makedirs(os.path.dirname(f), exist_ok=True)
    try:
        d = plistlib.load(open(f, "rb"))
    except Exception:
        d = {}
    d.update(DerivedDataLocationStyle="WorkspaceRelativePath", DerivedDataCustomLocation="DerivedData",
             BuildLocationStyle="UseAppPreferences", CustomBuildLocationType="RelativeToDerivedData")
    plistlib.dump(d, open(f, "wb"))


def cmd_new(a):
    if len(a.pos) < 2:
        raise Fail("usage: xcfs new <repo> <branch> [dest] [--from REF] [--session ID]", 2)
    repo = phys(a.pos[0]); branch = a.pos[1]
    if run("git", "-C", repo, "rev-parse", "--git-dir", check=False).returncode != 0:
        raise Fail("not a git repo: %s" % repo)
    repo = phys(git(repo, "rev-parse", "--show-toplevel"))
    dest = a.pos[2] if len(a.pos) > 2 else os.path.join(os.path.dirname(repo), "%s-wt-%s" % (os.path.basename(repo), branch.replace("/", "-")))
    parent = phys(os.path.dirname(os.path.abspath(os.path.expanduser(dest))))
    dest = os.path.join(parent, os.path.basename(dest.rstrip("/")))
    cfg = load_config(repo)
    seeds = [s for s in cfg.get("seed", []) if os.path.exists(os.path.join(repo, s))]
    if cfg.get("afterSeed") and not is_trusted(repo, cfg):
        raise Fail("%s wants to run %d command(s) in new worktrees; review them and run `xcfs trust %s`"
                   % (cfg["_path"], len(cfg["afterSeed"]), repo), 3)
    if not os.path.isdir(parent):
        raise Fail("no such directory: %s" % parent)
    if seeds:  # clonefile only exists inside one APFS volume; `cp -c` silently falls back to a full copy elsewhere
        if os.stat(repo).st_dev != os.stat(parent).st_dev or fs_type(parent) != "apfs":
            raise Fail("%s and %s are not on one APFS volume: the dependency layer would be copied in full, not cloned"
                       % (repo, parent), 4)
    with registry() as reg:
        if os.path.lexists(dest) or dest in reg["worktrees"]:
            raise Fail("destination already exists: %s" % dest)
        reg["worktrees"][dest] = {"state": "creating", "repo": repo, "branch": branch, "pid": os.getpid(),
                                  "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    made_branch = False
    t0 = time.time()
    try:
        with repo_lock(repo):
            if run("git", "-C", repo, "show-ref", "--verify", "--quiet", "refs/heads/" + branch, check=False).returncode == 0:
                git(repo, "worktree", "add", dest, branch)
            else:
                git(repo, "worktree", "add", "-b", branch, dest, *([a.opt["from"]] if a.opt.get("from") else []))
                made_branch = True
        t_git = time.time() - t0
        with registry() as reg:  # so a `new` that dies from here on can still be undone completely by `gc`
            reg["worktrees"][dest]["made_branch"] = made_branch
        seeded, warnings = [], []
        for rel in seeds:
            dst = os.path.join(dest, rel)
            if os.path.lexists(dst):
                continue
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            run("cp", "-c", "-R", os.path.join(repo, rel), dst)
            n = rewrite_paths(dst, repo, dest)
            seeded.append(rel)
            say("  seeded %s (clonefile)%s" % (rel, ", rewrote %d path(s)" % n if n else ""))
            if run("git", "-C", dest, "check-ignore", "-q", rel, check=False).returncode != 0:
                # Not ignored = the worktree is dirty from birth and `rm` / `reap` would refuse it forever.
                warnings.append("%s is not git-ignored: the worktree will always look dirty" % rel)
                say("  warning: " + warnings[-1])
        carried = {}
        for rel in cfg.get("carry", []):
            src = os.path.join(repo, rel)
            if os.path.isfile(src) and not os.path.lexists(os.path.join(dest, rel)):
                os.makedirs(os.path.dirname(os.path.join(dest, rel)), exist_ok=True)
                run("cp", "-c", src, os.path.join(dest, rel))
                carried[rel] = hashlib.sha256(open(src, "rb").read()).hexdigest()
        for c in cfg.get("afterSeed", []):
            r = subprocess.run(c, shell=True, cwd=dest, capture_output=True, text=True,
                               env=dict(os.environ, XCFS_WORKTREE=dest, XCFS_SOURCE=repo))
            if r.returncode != 0:
                raise Fail("afterSeed command failed (%d): %s\n%s" % (r.returncode, c, (r.stderr or r.stdout).strip()[:300]))
            say("  ran: %s" % c)
        if cfg.get("pinDerivedData"):
            for n in sorted(os.listdir(dest)):
                if n.endswith(".xcworkspace"):
                    pin_derived_data(os.path.join(dest, n)); say("  pinned DerivedData for %s" % n)
        session = session_of(a)
        with registry() as reg:
            reg["worktrees"][dest].update(state="ready", session=session, seeded=seeded, carried=carried,
                                          made_branch=made_branch)
            reg["worktrees"][dest].pop("pid", None)
    except BaseException:
        # Leave nothing half-made: the worktree, the branch this call created, the registry row.
        with repo_lock(repo):
            run("git", "-C", repo, "worktree", "remove", "--force", dest, check=False)
            if os.path.lexists(dest):
                shutil.rmtree(dest, ignore_errors=True)
            run("git", "-C", repo, "worktree", "prune", check=False)
            if made_branch:
                run("git", "-C", repo, "branch", "-D", branch, check=False)
        with registry() as reg:
            reg["worktrees"].pop(dest, None)
        raise
    RESULT.update(worktree=dest, branch=branch, seeded=seeded, warnings=warnings, seconds=round(time.time() - t0, 2), git_seconds=round(t_git, 2))
    say("worktree ready: %s  (%.1fs)" % (dest, time.time() - t0))
    if not session:
        say("  no session id: `xcfs reap` will not pick this one up")


# ---------------------------------------------------------------------- rm
def dd_buckets():
    """(dir, workspace_path|None, last_build_epoch) for every per-workspace DerivedData bucket. Buckets are named
    <name>-<28 lowercase letters>; anything else under the root is a layer shared by all workspaces."""
    out = []
    if not os.path.isdir(DD_ROOT):
        return out
    for n in os.listdir(DD_ROOT):
        d = os.path.join(DD_ROOT, n)
        if not os.path.isdir(d) or not re.search(r"-[a-z]{28}$", n):
            continue
        wp = None
        try:
            wp = plistlib.load(open(os.path.join(d, "info.plist"), "rb")).get("WorkspacePath")
        except Exception:
            pass
        # The bucket's own mtime never moves after creation; the build log directory's does.
        last = 0
        for sub in ("Logs/Build", "Build/Intermediates.noindex", "info.plist", ""):
            try:
                last = max(last, os.stat(os.path.join(d, sub)).st_mtime)
            except OSError:
                pass
        out.append((d, wp, last))
    return out


def ancestors():
    out, pid = set(), os.getpid()
    table = dict(l.split() for l in run("ps", "-axo", "pid=,ppid=").stdout.splitlines() if len(l.split()) == 2)
    while pid and str(pid) in table and str(pid) not in out:
        out.add(str(pid)); pid = int(table[str(pid)])
    return out


def users_of(wt):
    """Processes working inside THIS worktree (its path in their command line, or as their cwd). A build somewhere
    else on the machine is not a reason to refuse."""
    skip = ancestors(); hits = []
    # Our own helpers run from "/": a hook started with its cwd inside the worktree must not count itself.
    for l in run("ps", "-axo", "pid=,command=", cwd="/").stdout.splitlines():
        pid, _, cmdline = l.strip().partition(" ")
        if pid in skip:
            continue
        if re.search(re.escape(wt) + r"(?=/|\s|$|\")", cmdline):
            hits.append("%s %s" % (pid, cmdline.strip()[:70]))
    pid = None
    try:  # lsof can hang on a dead network mount; the command-line scan above still stands
        cwds = run("lsof", "-a", "-d", "cwd", "-Fpn", check=False, timeout=10, cwd="/").stdout.splitlines()
    except subprocess.TimeoutExpired:
        cwds = []
    for l in cwds:
        if l.startswith("p"):
            pid = l[1:]
        elif l.startswith("n") and pid not in skip and under(l[1:], wt):
            hits.append("%s (cwd %s)" % (pid, l[1:][-60:]))
    return sorted(set(hits))


def inspect_worktree(wt):
    """What would be lost by removing wt. Returns (problem_code, message) or (0, '')."""
    dirty = [l for l in git(wt, "status", "--porcelain").splitlines() if l.strip()]
    if dirty:
        return 5, "%d uncommitted file(s)" % len(dirty)
    return 0, ""


def trash_and_delete(path, trash_dir):
    """Rename (instant, same volume) then delete in the background, so a 30G DerivedData does not block the caller."""
    os.makedirs(trash_dir, exist_ok=True)
    dst = os.path.join(trash_dir, "%s.%d.%d" % (os.path.basename(path), int(time.time() * 1000), os.getpid()))
    os.rename(path, dst)
    subprocess.Popen(["/bin/rm", "-rf", dst], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return dst


def remove_worktree(wt, apply, discard_ignored=False, quiet=False, prune_branch=False):
    out = (lambda *_: None) if quiet else say
    if not os.path.isdir(wt):
        raise Fail("no such path: %s" % wt)
    r = run("git", "-C", wt, "rev-parse", "--git-common-dir", "--absolute-git-dir", check=False)
    if r.returncode != 0:
        raise Fail("not a git worktree: %s" % wt)
    common, gitdir = [phys(os.path.join(wt, x)) for x in r.stdout.split("\n")[:2]]
    if gitdir == common:
        raise Fail("%s is the main checkout, not a worktree: refusing" % wt)
    wt = phys(git(wt, "rev-parse", "--show-toplevel"))
    repo = os.path.dirname(common) if os.path.basename(common) == ".git" else common
    with registry(write=False) as reg:
        row = reg["worktrees"].get(wt, {})
    code, why = inspect_worktree(wt)
    branch = git(wt, "branch", "--show-current")
    stray = git(wt, "rev-list", "--max-count=1", "HEAD", "--not", "--branches", "--tags", "--remotes") if not branch else ""
    lost = []
    for rel, sha in row.get("carried", {}).items():  # ignored files `git status` cannot see
        f = os.path.join(wt, rel)
        if os.path.isfile(f) and hashlib.sha256(open(f, "rb").read()).hexdigest() != sha:
            lost.append(rel)
    mine = [d for d, wp, _ in dd_buckets() if wp and under(phys(wp), wt)]
    out("worktree: %s  (branch %s)" % (wt, branch or "detached"))
    for d in mine:
        out("  + global DerivedData %s" % os.path.basename(d))
    if stray:
        out("  detached HEAD has commits on no branch; they will be kept as refs/xcfs/rescue/…")
    if not apply:
        if code: out("  would refuse: %s" % why)
        if lost: out("  would refuse: changed ignored file(s): %s" % ", ".join(lost))
        out("dry-run: nothing removed. re-run with --apply.")
        return {"worktree": wt, "removed": False, "blocked": why or (", ".join(lost) if lost else "")}
    if code:
        raise Fail("%s in %s: commit or stash first, xcfs will not force" % (why, wt), code)
    if lost and not discard_ignored:
        raise Fail("ignored file(s) changed in %s and exist nowhere else: %s (pass --discard-ignored to drop them)"
                   % (wt, ", ".join(lost)), 7)
    busy = users_of(wt)
    if busy:
        raise Fail("%s is in use by: %s" % (wt, "; ".join(busy[:3])), 6)
    rescue = None
    if stray:
        rescue = "refs/xcfs/rescue/%s-%s" % (os.path.basename(wt), time.strftime("%Y%m%d-%H%M%S"))
        git(repo, "update-ref", rescue, git(wt, "rev-parse", "HEAD"))
        out("  kept detached commits as %s" % rescue)
    for d in mine:
        trash_and_delete(d, os.path.join(DD_ROOT, TRASH))
    trash_and_delete(wt, os.path.join(os.path.dirname(wt), TRASH))
    with registry() as reg:          # the directory is gone: the record goes too, whatever git says next
        reg["worktrees"].pop(wt, None)
    with repo_lock(repo):
        run("git", "-C", repo, "worktree", "prune", check=False)
    branch_deleted = False
    if prune_branch and branch and row.get("made_branch"):
        # Only a branch xcfs itself created, and only when it holds nothing that is not reachable from another ref.
        if not git(repo, "rev-list", "--max-count=1", branch, "--not", "--exclude=" + branch, "--branches", "--tags", "--remotes", check=False):
            branch_deleted = run("git", "-C", repo, "branch", "-D", branch, check=False).returncode == 0
            if branch_deleted: out("  deleted branch %s (xcfs created it and it never got a commit of its own)" % branch)
    out("removed (deleting in the background).")
    return {"worktree": wt, "removed": True, "blocked": "", "rescue_ref": rescue, "derived_data": len(mine),
            "branch": branch, "branch_deleted": branch_deleted}


def cmd_rm(a):
    if not a.pos:
        raise Fail("usage: xcfs rm <worktree> [--apply] [--discard-ignored]", 2)
    RESULT.update(remove_worktree(phys(a.pos[0]), a.flag("apply"), a.flag("discard-ignored"), prune_branch=a.flag("prune-branch")))


def cmd_reap(a):
    sid, older = session_of(a), a.opt.get("older-than")
    if a.flag("all") or older is not None:
        sid = a.opt.get("session", "")           # with --all / --older-than the session is only an optional extra filter
    elif not sid:
        raise Fail("which worktrees? pass --session ID (or set XCFS_SESSION), --older-than DAYS, or --all", 2)
    cutoff = time.time() - float(older) * 86400 if older is not None else None
    with registry(write=False) as reg:
        mine = [p for p, r in reg["worktrees"].items() if r.get("state") == "ready"
                and (not sid or r.get("session") == sid) and (cutoff is None or created_epoch(r) <= cutoff)]
    done = []
    for wt in sorted(mine):
        if not os.path.isdir(wt):
            continue
        try:
            r = remove_worktree(wt, a.flag("apply"), quiet=True, prune_branch=a.flag("prune-branch"))
            say("  %s  %s" % ("REAP" if r["removed"] or not r["blocked"] else "SKIP", wt) + ("  (%s)" % r["blocked"] if r["blocked"] else ""))
            done.append(r)
        except Fail as e:
            say("  SKIP  %s  (%s)" % (wt, str(e)[:90])); done.append({"worktree": wt, "removed": False, "blocked": str(e)})
    if not mine:
        say("no matching worktrees" + (" from session %s" % sid[:8] if sid else ""))
    elif not a.flag("apply"):
        say("dry-run: nothing removed. re-run with --apply.")
    RESULT.update(session=sid, worktrees=done, removed=sum(1 for d in done if d["removed"]),
                  left=[d["worktree"] for d in done if not d["removed"]] if a.flag("apply") else [])


# ---------------------------------------------------------------------- gc
def cmd_gc(a):
    apply, days = a.flag("apply"), int(a.opt.get("stale-days", 21))
    actions = []
    with registry() as reg:
        for p, r in list(reg["worktrees"].items()):
            alive = True
            if r.get("state") == "creating":
                try:
                    os.kill(int(r.get("pid", 0)), 0)
                except (OSError, ValueError):
                    alive = False
            if not os.path.isdir(p) or not alive:  # removed behind our back, or a `new` that died half way
                actions.append(("stale registry row", p))
                if apply:
                    with repo_lock(r["repo"]):
                        if not alive and os.path.isdir(p):
                            run("git", "-C", r["repo"], "worktree", "remove", "--force", p, check=False)
                            if os.path.lexists(p):
                                shutil.rmtree(p, ignore_errors=True)
                        run("git", "-C", r["repo"], "worktree", "prune", check=False)
                        if not alive and r.get("made_branch"):
                            run("git", "-C", r["repo"], "branch", "-D", r["branch"], check=False)
                    reg["worktrees"].pop(p)
        roots = {os.path.dirname(p) for p in reg["worktrees"]} | {os.path.dirname(a_[1]) for a_ in actions}
        owned = set(reg["worktrees"])
    for root in list(roots) + [DD_ROOT]:
        t = os.path.join(root, TRASH)
        if os.path.isdir(t):
            for n in os.listdir(t):  # a background delete that was interrupted (reboot, kill)
                actions.append(("leftover trash", os.path.join(t, n)))
                if apply:
                    subprocess.Popen(["/bin/rm", "-rf", os.path.join(t, n)], start_new_session=True)
    foreign = []
    now = time.time()
    for d, wp, last in dd_buckets():
        age = int((now - last) / 86400)
        if wp and any(under(phys(wp), o) for o in owned):
            continue
        kind = "orphan (no info.plist)" if not wp else "orphan (workspace path is gone)" if not os.path.exists(wp) \
            else "stale (%dd since last build)" % age if age >= days else None
        if kind:
            foreign.append((kind, d, wp))
    for kind, p in actions:
        say("  %-20s %s" % (kind, p))
    if a.flag("foreign"):
        say("global DerivedData not created through xcfs:")
        for kind, d, wp in foreign:
            say("  %8s  %-32s %s" % (human(du_kb(d)), kind, os.path.basename(d)))
            if apply:
                if wp and users_of(phys(wp)) and os.path.exists(wp):
                    say("            in use, skipped"); continue
                trash_and_delete(d, os.path.join(DD_ROOT, TRASH))
    elif foreign:
        say("%d global DerivedData bucket(s) look orphaned or stale; they were not created through xcfs, so they are "
            "left alone (see them with --foreign)" % len(foreign))
    if not apply and (actions or (foreign and a.flag("foreign"))):
        say("dry-run: nothing removed. re-run with --apply.")
    if not actions and not foreign:
        say("nothing to reclaim.")
    RESULT.update(actions=[list(x) for x in actions], foreign=[[k, d] for k, d, _ in foreign], applied=apply)


def created_epoch(r):
    import calendar
    try:
        return calendar.timegm(time.strptime(r.get("created", ""), "%Y-%m-%dT%H:%M:%SZ"))
    except ValueError:
        return 0


def cmd_ls(a):
    with registry(write=False) as reg:
        rows = sorted(reg["worktrees"].items())
    if "session" in a.opt:
        rows = [(p, r) for p, r in rows if r.get("session") == a.opt["session"]]
    out = []
    for p, r in rows:
        row = {"worktree": p, "branch": r.get("branch"), "state": r.get("state") if os.path.isdir(p) else "missing",
               "session": r.get("session", ""), "seeded": r.get("seeded", []),
               "age_days": round((time.time() - created_epoch(r)) / 86400, 1)}
        extra = ""
        if a.flag("status") and os.path.isdir(p):
            row["dirty"] = len([l for l in git(p, "status", "--porcelain", check=False).splitlines() if l.strip()])
            n = git(p, "rev-list", "--count", "HEAD", "--not", "--remotes", check=False)
            row["unpushed"] = int(n) if n.isdigit() else 0
            row["branch"] = git(p, "branch", "--show-current", check=False) or "detached"
            extra = "  dirty=%d unpushed=%d age=%.1fd" % (row["dirty"], row["unpushed"], row["age_days"])
        if a.flag("sizes") and os.path.isdir(p):
            row["kb"] = du_kb(p)
        out.append(row)
        say("  %-8s %-9s %s  [%s]%s%s" % (row["state"], (row["session"] or "-")[:8], p, row["branch"], extra,
                                          "  " + human(row["kb"]) if "kb" in row else ""))
    if not rows:
        say("no worktrees created through xcfs.")
    RESULT.update(worktrees=out)


def cmd_adopt(a):
    if not a.pos:
        raise Fail("usage: xcfs adopt <worktree> [--session ID | --release]", 2)
    wt = phys(a.pos[0])
    r = run("git", "-C", wt, "rev-parse", "--git-common-dir", "--absolute-git-dir", "--show-toplevel", check=False)
    if r.returncode != 0:
        raise Fail("not a git worktree: %s" % wt)
    common, gitdir, top = [phys(os.path.join(wt, x)) for x in r.stdout.split("\n")[:3]]
    if gitdir == common:
        raise Fail("%s is the main checkout: xcfs only manages worktrees" % top)
    sid = "" if a.flag("release") else session_of(a)
    if not sid and not a.flag("release"):
        raise Fail("which session? pass --session ID (or set XCFS_SESSION), or --release to exempt it from reap", 2)
    with registry() as reg:
        row = reg["worktrees"].setdefault(top, {
            "state": "ready", "repo": os.path.dirname(common) if os.path.basename(common) == ".git" else common,
            "branch": git(top, "branch", "--show-current"), "seeded": [], "carried": {}, "made_branch": False,
            "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())})
        if row.get("state") != "ready":
            raise Fail("%s is still being created" % top)
        row["session"] = sid
    say("%s now belongs to %s" % (top, "session " + sid[:8] if sid else "no session (reap will leave it alone)"))
    RESULT.update(worktree=top, session=sid)


def cmd_doctor(a):
    probs = []
    def check(ok, msg):
        say("  %s %s" % ("ok  " if ok else "FAIL", msg))
        if not ok: probs.append(msg)
    check(shutil.which("git") is not None, "git on PATH")
    os.makedirs(STATE, exist_ok=True)
    check(fs_type(STATE) == "apfs", "state directory is on APFS (%s)" % STATE)
    root = phys(a.pos[0]) if a.pos else None
    if root:
        check(fs_type(root) == "apfs", "%s is on APFS (clonefile needs it)" % root)
        # Xcode walks every non-hidden file under a local package directory each time it resolves the package graph;
        # hidden directories are skipped (measured: 105k stray files made resolution take 24s instead of 12s).
        bad = []
        for dp, dns, fns in os.walk(root):
            dns[:] = [d for d in dns if not d.startswith(".") and d not in ("node_modules", "Pods")]
            if "Package.swift" in fns:
                for d in list(dns):
                    if d == "build" or d.startswith("DerivedData"):
                        n = sum(len(f) for _, _, f in os.walk(os.path.join(dp, d)))
                        if n:
                            bad.append("%s (%d files)" % (os.path.join(dp, d), n))
                        dns.remove(d)
            if dp.count(os.sep) - root.count(os.sep) >= 4:
                dns[:] = []
        check(not bad, "no build output inside local package directories" + ("".join("\n         " + b for b in bad)))
    with registry(write=False) as reg:
        gone = [p for p in reg["worktrees"] if not os.path.isdir(p)]
    check(not gone, "registry matches disk" + (" (%d row(s) point nowhere: run `xcfs gc --apply`)" % len(gone) if gone else ""))
    RESULT.update(problems=probs)
    if probs:
        raise Fail("%d problem(s)" % len(probs))


def cmd_trust(a):
    if not a.pos:
        raise Fail("usage: xcfs trust <repo>", 2)
    repo = phys(git(phys(a.pos[0]), "rev-parse", "--show-toplevel")); cfg = load_config(repo)
    if not cfg.get("afterSeed"):
        say("nothing to approve: no afterSeed commands in %s" % (cfg["_path"] or "any config")); return
    say("%s will run in every new worktree of %s:" % (cfg["_path"], repo))
    for c in cfg["afterSeed"]:
        say("    %s" % c)
    os.makedirs(STATE, exist_ok=True)
    with registry(write=False):
        f = os.path.join(STATE, "trust.json")
        try:
            t = json.load(open(f))
        except (FileNotFoundError, ValueError):
            t = {}
        t[trust_key(repo, cfg)] = {"repo": repo, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
        json.dump(t, open(f + ".tmp", "w"), indent=1); os.replace(f + ".tmp", f)
    say("approved. Changing those commands asks again.")
    RESULT.update(trusted=repo)


class Args:
    VALUE = {"session", "from", "stale-days", "older-than"}

    def __init__(self, argv):
        self.pos, self.opt, self.flags = [], {}, set()
        i = 0
        while i < len(argv):
            x = argv[i]
            if x.startswith("--"):
                k = x[2:]
                if k in self.VALUE:
                    if i + 1 >= len(argv): raise Fail("--%s needs a value" % k, 2)
                    self.opt[k] = argv[i + 1]; i += 1
                else:
                    self.flags.add(k)
            else:
                self.pos.append(x)
            i += 1

    def flag(self, k):
        return k in self.flags


COMMANDS = {"new": cmd_new, "rm": cmd_rm, "reap": cmd_reap, "adopt": cmd_adopt, "gc": cmd_gc, "ls": cmd_ls,
            "doctor": cmd_doctor, "trust": cmd_trust}
KNOWN_FLAGS = {"apply", "dry-run", "json", "discard-ignored", "foreign", "sizes", "status", "all", "prune-branch", "release"}
VERSION = "0.1.0"


def main(argv):
    global JSON_OUT
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip()); return 0
    if argv[0] in ("--version", "version"):
        print("xcfs " + VERSION); return 0
    name, code = argv[0], 0
    JSON_OUT = "--json" in argv
    try:
        if name not in COMMANDS:
            raise Fail("unknown command: %s (see xcfs --help)" % name, 2)
        a = Args(argv[1:])
        if a.flag("help") or "-h" in a.pos:
            print(__doc__.strip()); return 0
        bad = a.flags - KNOWN_FLAGS
        if bad:
            raise Fail("unknown flag: --%s" % sorted(bad)[0], 2)
        JSON_OUT = a.flag("json")
        COMMANDS[name](a)
    except Fail as e:
        code = e.code; RESULT["error"] = str(e)
        if not JSON_OUT:
            print("error: %s" % e, file=sys.stderr)
    except KeyboardInterrupt:
        code = 130; RESULT["error"] = "interrupted"
    except Exception as e:  # a bug in xcfs: still answer in the promised format, never with a bare traceback
        import traceback
        code = 1; RESULT["error"] = "internal error: %s: %s" % (type(e).__name__, e)
        RESULT["traceback"] = traceback.format_exc().splitlines()[-3:]
        if not JSON_OUT:
            print("error: %s\n%s" % (RESULT["error"], traceback.format_exc()), file=sys.stderr)
    if JSON_OUT:
        RESULT["ok"] = code == 0
        print(json.dumps(RESULT, ensure_ascii=False))
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
