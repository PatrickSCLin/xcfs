+//
+//===----------------------------------------------------------------------===//
+// Added by the xcfs project to swift-driver 6.4.2.
+//
+// Experimental: per-name semantic digests of a module's API, so that a client
+// rebuilds only the files that use names whose meaning changed.
+//
+// The module dependency graph embedded in a .swiftmodule treats the whole
+// module as one "source file": any change to its interface changes the
+// module's fingerprint, and the frontend links that fingerprint to every
+// declaration the module defines. A client then recompiles every file that
+// uses any name from the module. Top-level functions, extension members and
+// type headers carry no fingerprint of their own, so the graph alone cannot
+// tell which declarations really changed.
+//
+// When the environment variable SWIFT_DRIVER_API_DIGEST_DIR names a directory:
+//  - after the build, the driver extracts a symbol graph (all access levels) from
+//    the emitted binary module and turns it into one digest per dependency key
+//    (top-level name, type, member of a type, any member name) and stores it as
+//    <dir>/<module>/<graph key>.json, where the graph key hashes every node and
+//    fingerprint of the module's dependency graph (the module fingerprint alone
+//    does not change when only a type body changes);
+//  - when a client integrates a changed module, it looks up the digests of the
+//    graph it had integrated before and of the new one, and invalidates only the declarations whose
+//    digest differs. A key missing from either side counts as changed; a
+//    missing digest file falls back to the stock behavior.
+//
+// A digest covers what a declaration's users depend on: its declaration
+// fragments, generic signature and USR (which spells out resolved types), and
+// the layout of every same-module type it refers to (stored properties, enum
+// cases, superclass and conformances, transitively; all members for classes,
+// actors and protocols).
+//
+//===----------------------------------------------------------------------===//
+
+import Foundation
+#if canImport(Darwin)
+import Darwin
+#endif
+import class Dispatch.DispatchQueue
+import protocol TSCBasic.FileSystem
+import struct TSCBasic.AbsolutePath
+import var TSCBasic.localFileSystem
+#if canImport(CryptoKit)
+import CryptoKit
+#endif
+
+public enum APIDigests {
+  static let environmentKey = "SWIFT_DRIVER_API_DIGEST_DIR"
+  static let symbolGraphDirSuffix = ".api-digest-symbolgraph"
+
+  /// The digest store, if the feature is on.
+  static var storeDir: URL? {
+    #if canImport(CryptoKit)
+    guard let dir = ProcessInfo.processInfo.environment[environmentKey], !dir.isEmpty else { return nil }
+    // One spelling of the path: Clang refuses a module cache whose modules it finds under two paths.
+    return URL(fileURLWithPath: dir, isDirectory: true).resolvingSymlinksInPath().standardizedFileURL
+    #else
+    return nil
+    #endif
+  }
+
+  /// Where the emit-module job writes the symbol graph for a module at `modulePath`.
+  static func symbolGraphDir(forModuleAt modulePath: String) -> String {
+    modulePath + symbolGraphDirSuffix
+  }
+
+  /// Whether changed source-file interfaces of the module being built are narrowed with digests.
+  enum IntraModuleState {
+    case off
+    /// Waiting for the emit-module job; holds the digests of the module as it was before this build.
+    case pending(Digests)
+    case decided(old: Digests, new: Digests)
+    /// The new digests could not be had: changes invalidate whole files, as the stock driver does.
+    case fallback
+  }
+
+  /// The module this driver emits: where, its name, and the toolchain's frontend.
+  nonisolated(unsafe) static var emittedModule: (path: String, name: String, frontend: String?)?
+
+  /// The nodes whose digest differs between `old` and `new`, or is missing from either.
+  static func changedNodes(_ nodes: [ModuleDependencyGraph.Node], old: Digests, new: Digests,
+                           holder: InternedStringTableHolder) -> [ModuleDependencyGraph.Node] {
+    nodes.filter { node in
+      switch node.key.designator {
+      case .externalDepend, .sourceFileProvide: return false
+      default:
+        let a = old.value(for: node.key.designator, in: holder)
+        let b = new.value(for: node.key.designator, in: holder)
+        return a == nil || b == nil || a != b
+      }
+    }
+  }
+
+  /// The stored digests of one version of a module.
+  struct Digests {
+    var top: [String: String] = [:]
+    var type: [String: String] = [:]
+    var member: [String: String] = [:]
+    var any: [String: String] = [:]
+
+    func value(for designator: DependencyKey.Designator, in holder: InternedStringTableHolder) -> String? {
+      switch designator {
+      case .topLevel(name: let n): return top[n.lookup(in: holder)]
+      case .nominal(context: let c), .potentialMember(context: let c):
+        // An extension is keyed by its extended type plus "@" and a hash of the extension;
+        // the whole type's digest covers it.
+        let context = c.lookup(in: holder)
+        return type[context] ?? context.split(separator: "@", maxSplits: 1).first.flatMap { type[String($0)] }
+      case .member(context: let c, name: let n):
+        // Members the symbol graph leaves out are synthesized (e.g. an inferred associated type);
+        // the type they belong to determines them.
+        let context = c.lookup(in: holder)
+        return member[context + " " + n.lookup(in: holder)] ?? type[context]
+      case .dynamicLookup(name: let n): return any[n.lookup(in: holder)]
+      case .externalDepend, .sourceFileProvide: return nil
+      }
+    }
+  }
+
+  // MARK: - Store
+
+  static func fileURL(module: String, fingerprint: String) -> URL? {
+    guard let store = storeDir else { return nil }
+    let safe = { (s: String) in String(s.map { $0.isLetter || $0.isNumber || $0 == "_" || $0 == "-" ? $0 : "_" }) }
+    return store.appendingPathComponent(safe(module), isDirectory: true)
+      .appendingPathComponent(safe(fingerprint) + ".json")
+  }
+
+  static func load(module: String, fingerprint: String, waitForJob: Bool = true) -> Digests? {
+    guard let url = fileURL(module: module, fingerprint: fingerprint) else { return nil }
+    if waitForJob { waitForPendingJob(url) }
+    guard let data = try? Data(contentsOf: url),
+          let obj = try? JSONSerialization.jsonObject(with: data) as? [String: Any]
+    else { return nil }
+    func map(_ k: String) -> [String: String] { obj[k] as? [String: String] ?? [:] }
+    return Digests(top: map("top"), type: map("type"), member: map("member"), any: map("any"))
+  }
+
+  /// If a background job is extracting these digests (its marker is younger than five minutes), wait for it,
+  /// at most a minute.
+  static func waitForPendingJob(_ url: URL) {
+    let fm = FileManager.default
+    let pending = url.deletingPathExtension().appendingPathExtension("pending")
+    guard !fm.fileExists(atPath: url.path),
+          let made = (try? fm.attributesOfItem(atPath: pending.path))?[.modificationDate] as? Date,
+          Date().timeIntervalSince(made) < 300
+    else { return }
+    let deadline = Date().addingTimeInterval(60)
+    while Date() < deadline, fm.fileExists(atPath: pending.path), !fm.fileExists(atPath: url.path) {
+      usleep(50_000)
+    }
+  }
+
+  static func store(_ d: Digests, module: String, fingerprint: String) {
+    guard let url = fileURL(module: module, fingerprint: fingerprint) else { return }
+    let obj: [String: Any] = ["version": 1, "module": module,
+                              "top": d.top, "type": d.type, "member": d.member, "any": d.any]
+    guard let data = try? JSONSerialization.data(withJSONObject: obj, options: [.sortedKeys]) else { return }
+    try? FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+    prune(url.deletingLastPathComponent(), keep: 63)
+    let tmp = url.appendingPathExtension("tmp\(ProcessInfo.processInfo.processIdentifier)")
+    do {
+      try data.write(to: tmp)
+      _ = try? FileManager.default.removeItem(at: url)
+      try FileManager.default.moveItem(at: tmp, to: url)
+    } catch {
+      _ = try? FileManager.default.removeItem(at: tmp)
+    }
+  }
+
+  /// Keep the newest `keep` digest files of a module (a client only ever needs the version it built
+  /// against last and the current one).
+  static func prune(_ dir: URL, keep: Int) {
+    let fm = FileManager.default
+    guard let names = try? fm.contentsOfDirectory(atPath: dir.path) else { return }
+    let files = names.filter { $0.hasSuffix(".json") }.map { dir.appendingPathComponent($0) }
+    guard files.count > keep else { return }
+    let dated = files.map { ($0, ((try? fm.attributesOfItem(atPath: $0.path))?[.modificationDate] as? Date) ?? .distantPast) }
+    for (f, _) in dated.sorted(by: { $0.1 > $1.1 }).dropFirst(keep) { try? fm.removeItem(at: f) }
+  }
+
+  // MARK: - Producer side
+
+  /// How to load the module this driver emits (search paths, SDK, target, Clang arguments).
+  nonisolated(unsafe) static var extractionArguments: [String]?
+
+  /// The first argument with which the driver runs a background extraction job instead of compiling.
+  public static let jobFlag = "-api-digests-extract-job"
+
+  /// Called after a build: unless this version of the emitted module already has digests, extract them in a
+  /// background process, so that the build does not wait (a first build emits every module once). A client that
+  /// needs them before the job is done waits for it (see ``load(module:fingerprint:)``).
+  static func recordEmittedModule(modulePath: String, moduleName: String, fileSystem: FileSystem,
+                                  frontendPath: String?) {
+    let debug = ProcessInfo.processInfo.environment["SWIFT_DRIVER_API_DIGEST_DEBUG"] != nil
+    func say(_ s: String) { if debug { FileHandle.standardError.write(Data("api-digests: \(moduleName): \(s)\n".utf8)) } }
+    guard storeDir != nil else { return say("no store") }
+    guard let loadArgs = extractionArguments else { return say("no extraction arguments (no emit-module job)") }
+    guard let frontend = frontendPath else { return say("no frontend") }
+    guard FileManager.default.fileExists(atPath: modulePath) else { return say("no module at \(modulePath)") }
+    guard let key = moduleGraphKey(modulePath: modulePath, fileSystem: fileSystem) else {
+      return say("no dependency graph in \(modulePath)")
+    }
+    guard let url = fileURL(module: moduleName, fingerprint: key) else { return say("no store path") }
+    guard !FileManager.default.fileExists(atPath: url.path) else { return say("digests exist: \(url.path)") }
+    say("extracting in the background: \(url.path)")
+    try? FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+    let job = url.deletingPathExtension().appendingPathExtension("job")
+    let pending = url.deletingPathExtension().appendingPathExtension("pending")
+    let spec: [String: Any] = ["modulePath": modulePath, "moduleName": moduleName, "frontend": frontend,
+                               "loadArgs": loadArgs, "key": key]
+    guard let data = try? JSONSerialization.data(withJSONObject: spec),
+          (try? data.write(to: job)) != nil,
+          (try? Data().write(to: pending)) != nil
+    else { return }
+    let me = ProcessInfo.processInfo.arguments[0]
+    var attrs: posix_spawnattr_t? = nil
+    posix_spawnattr_init(&attrs)
+    posix_spawnattr_setflags(&attrs, Int16(POSIX_SPAWN_SETSID))
+    var actions: posix_spawn_file_actions_t? = nil
+    posix_spawn_file_actions_init(&actions)
+    for fd: Int32 in [0, 1, 2] {
+      posix_spawn_file_actions_addopen(&actions, fd, "/dev/null", fd == 0 ? O_RDONLY : O_WRONLY, 0)
+    }
+    let argv: [UnsafeMutablePointer<CChar>?] = [strdup(me), strdup(jobFlag), strdup(job.path), nil]
+    var pid: pid_t = 0
+    let rc = posix_spawn(&pid, me, &actions, &attrs, argv, environ)
+    for a in argv { free(a) }
+    posix_spawn_file_actions_destroy(&actions)
+    posix_spawnattr_destroy(&attrs)
+    if rc != 0 {
+      try? FileManager.default.removeItem(at: pending)
+      try? FileManager.default.removeItem(at: job)
+    }
+  }
+
+  /// The background job: extract and store the digests a finished build asked for.
+  public static func runJob(_ jobPath: String) -> Int32 {
+    let job = URL(fileURLWithPath: jobPath)
+    defer {
+      try? FileManager.default.removeItem(at: job.deletingPathExtension().appendingPathExtension("pending"))
+      try? FileManager.default.removeItem(at: job)
+    }
+    guard let data = try? Data(contentsOf: job),
+          let spec = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+          let modulePath = spec["modulePath"] as? String, let moduleName = spec["moduleName"] as? String,
+          let frontend = spec["frontend"] as? String, let loadArgs = spec["loadArgs"] as? [String],
+          let key = spec["key"] as? String
+    else { return 1 }
+    extractionArguments = loadArgs
+    // The digests must describe the version the build emitted; a later build may have replaced it already.
+    return digestsOfEmittedModule(modulePath: modulePath, moduleName: moduleName, fileSystem: localFileSystem,
+                                  frontendPath: frontend, expectedKey: key) == nil ? 1 : 0
+  }
+
+  /// The digests of the module at `modulePath`, from the store or extracted now (and stored).
+  static func digestsOfEmittedModule(modulePath: String, moduleName: String, fileSystem: FileSystem,
+                                     frontendPath: String?, expectedKey: String? = nil) -> Digests? {
+    guard let storeURL = storeDir, let loadArgs = extractionArguments,
+          FileManager.default.fileExists(atPath: modulePath),
+          let key = moduleGraphKey(modulePath: modulePath, fileSystem: fileSystem),
+          expectedKey == nil || expectedKey == key,
+          let url = fileURL(module: moduleName, fingerprint: key)
+    else { return nil }
+    let fm = FileManager.default
+    if let stored = load(module: moduleName, fingerprint: key, waitForJob: expectedKey == nil) { return stored }
+    guard let frontend = frontendPath else { return nil }
+    let tool = (frontend as NSString).deletingLastPathComponent + "/swift-symbolgraph-extract"
+    let outDir = symbolGraphDir(forModuleAt: modulePath)
+    try? fm.removeItem(atPath: outDir)
+    try? fm.createDirectory(atPath: outDir, withIntermediateDirectories: true)
+    let cache = storeURL.appendingPathComponent("ModuleCache").path
+    let moduleDir = (modulePath as NSString).deletingLastPathComponent
+    let args = ["-module-name", moduleName, "-I", moduleDir] + loadArgs +
+      ["-module-cache-path", cache, "-minimum-access-level", "private", "-skip-inherited-docs", "-skip-synthesized-members",
+       "-output-dir", outDir]
+    let started = Date()
+    let process = Process()
+    process.executableURL = URL(fileURLWithPath: tool)
+    process.arguments = args
+    let errPipe = Pipe()
+    process.standardError = errPipe
+    process.standardOutput = FileHandle.nullDevice
+    var status: Int32 = -1
+    var errText = ""
+    do {
+      try process.run()
+      let errData = errPipe.fileHandleForReading.readDataToEndOfFile()
+      process.waitUntilExit()
+      status = process.terminationStatus
+      errText = String(decoding: errData.suffix(4000), as: UTF8.self)
+    } catch {
+      errText = "\(error)"
+    }
+    let files = ((try? fm.contentsOfDirectory(atPath: outDir)) ?? []).filter { $0.hasSuffix(".symbols.json") }
+    let extracted = Date()
+    var digests: Digests?
+    if status == 0, !files.isEmpty {
+      digests = compute(symbolGraphFiles: files.map { outDir + "/" + $0 })
+    }
+    let bytes = files.reduce(0) { $0 + (((try? fm.attributesOfItem(atPath: outDir + "/" + $1))?[.size] as? Int) ?? 0) }
+    if let d = digests { store(d, module: moduleName, fingerprint: key) }
+    // A short log per module, for diagnosing extraction failures.
+    let log = "\(Date()) key=\(key) status=\(status) files=\(files.count) stored=\(digests != nil) " +
+      "seconds=\(String(format: "%.2f", Date().timeIntervalSince(started))) " +
+      "extract=\(String(format: "%.2f", extracted.timeIntervalSince(started))) bytes=\(bytes)\n" +
+      (status == 0 && ProcessInfo.processInfo.environment["SWIFT_DRIVER_API_DIGEST_LOG_ARGS"] == nil
+        ? "" : "\(tool) \(args.joined(separator: " "))\n\(errText)\n")
+    try? fm.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+    let logURL = url.deletingLastPathComponent().appendingPathComponent("extract.log")
+    if let h = try? FileHandle(forWritingTo: logURL) {
+      h.seekToEndOfFile(); h.write(Data(log.utf8)); try? h.close()
+    } else {
+      try? Data(log.utf8).write(to: logURL)
+    }
+    try? fm.removeItem(atPath: outDir)
+    return digests
+  }
+
+  /// Identifies one version of a module's dependency graph: every definition node's key and fingerprint.
+  /// The module fingerprint alone does not change when only a type body changes.
+  static func graphKey(_ entries: [String]) -> String {
+    #if canImport(CryptoKit)
+    let text = entries.sorted().joined(separator: "\n")
+    return SHA256.hash(data: Data(text.utf8)).prefix(16).map { String(format: "%02x", $0) }.joined()
+    #else
+    return ""
+    #endif
+  }
+
+  static func graphKeyEntry(_ key: DependencyKey, _ fingerprint: InternedString?,
+                            in holder: InternedStringTableHolder) -> String? {
+    if case .externalDepend = key.designator { return nil }
+    return key.description(in: holder) + "|" + (fingerprint?.lookup(in: holder) ?? "-")
+  }
+
+  /// The graph key of the module at `modulePath`, from its embedded dependency graph.
+  static func moduleGraphKey(modulePath: String, fileSystem: FileSystem) -> String? {
+    let queue = DispatchQueue(label: "api-digests")
+    return queue.sync { () -> String? in
+      let table = InternedStringTable(queue)
+      guard let path = try? VirtualPath(path: modulePath),
+            let graph = try? SourceFileDependencyGraph.read(
+              from: TypedVirtualPath(file: path.intern(), type: .swiftModule),
+              on: fileSystem, internedStringTable: table)
+      else { return nil }
+      var entries: [String] = []
+      graph.forEachNode { node in
+        guard node.definitionVsUse == .definition,
+              let e = graphKeyEntry(node.key, node.fingerprint, in: table) else { return }
+        entries.append(e)
+      }
+      return entries.isEmpty ? nil : graphKey(entries)
+    }
+  }
+
+  // MARK: - Computing digests from a symbol graph
+
+  static func compute(symbolGraphFiles: [String]) -> Digests? {
+    #if canImport(CryptoKit)
+    struct Sym {
+      var usr: String
+      var kind: String
+      var path: [String]
+      var base: String       // canonical text of what users depend on
+      var refs: [String]     // USRs referenced by the declaration
+    }
+    var syms: [String: Sym] = [:]
+    var members: [String: [String]] = [:]       // type USR -> member USRs
+    var memberOf: [String: String] = [:]        // member USR -> type USR
+    var supers: [String: [String]] = [:]        // type USR -> conformances / superclass USRs
+    var conformances: [String: [String]] = [:]  // type USR -> "conformsTo<USR>" / "inheritsFrom<USR>"
+
+    var moduleName = ""
+    for file in symbolGraphFiles.sorted() {
+      guard let data = FileManager.default.contents(atPath: file),
+            let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any]
+      else { return nil }
+      if moduleName.isEmpty, let m = (root["module"] as? [String: Any])?["name"] as? String,
+         !file.contains("@") {
+        moduleName = m
+      }
+      for s in root["symbols"] as? [[String: Any]] ?? [] {
+        guard let id = s["identifier"] as? [String: Any], let usr = id["precise"] as? String,
+              let kind = (s["kind"] as? [String: Any])?["identifier"] as? String
+        else { continue }
+        var refs: [String] = []
+        var text: [String] = []
+        for f in s["declarationFragments"] as? [[String: Any]] ?? [] {
+          text.append(f["spelling"] as? String ?? "")
+          if let r = f["preciseIdentifier"] as? String { refs.append(r); text.append("<\(r)>") }
+        }
+        var canon: [String: Any] = ["usr": usr, "kind": kind, "fragments": text]
+        for k in ["pathComponents", "accessLevel", "swiftGenerics", "swiftExtension", "functionSignature",
+                  "availability", "spi"] {
+          if let v = s[k] { canon[k] = v }
+        }
+        let base = (try? JSONSerialization.data(withJSONObject: canon, options: [.sortedKeys]))
+          .map { String(decoding: $0, as: UTF8.self) } ?? usr
+        let path = s["pathComponents"] as? [String] ?? []
+        if var existing = syms[usr] {
+          existing.base += "\n" + base
+          existing.refs += refs
+          syms[usr] = existing
+        } else {
+          syms[usr] = Sym(usr: usr, kind: kind, path: path, base: base, refs: refs)
+        }
+      }
+      for r in root["relationships"] as? [[String: Any]] ?? [] {
+        guard let kind = r["kind"] as? String, let src = r["source"] as? String, let dst = r["target"] as? String
+        else { continue }
+        switch kind {
+        case "memberOf":
+          members[dst, default: []].append(src)
+          memberOf[src] = dst
+        case "conformsTo", "inheritsFrom":
+          supers[src, default: []].append(dst)
+          conformances[src, default: []].append(kind + "<" + dst + ">")
+        case "requirementOf", "optionalRequirementOf":
+          members[dst, default: []].append(src)
+          memberOf[src] = dst
+        default:
+          // overrides, defaultImplementationOf, extensionTo: record them in the source's text
+          if var s = syms[src] { s.base += "\n\(kind)<\(dst)>"; syms[src] = s }
+        }
+      }
+    }
+
+    let typeKinds: Set<String> = ["swift.struct", "swift.enum", "swift.class", "swift.protocol", "swift.actor",
+                                  "swift.typealias", "swift.associatedtype"]
+    let allMemberKinds: Set<String> = ["swift.class", "swift.protocol", "swift.actor"]
+    let layoutMemberKinds: Set<String> = ["swift.property", "swift.enum.case"]
+
+    // Edges a declaration's meaning depends on.
+    func edges(_ usr: String) -> [String] {
+      guard let s = syms[usr] else { return [] }
+      var out = s.refs.filter { syms[$0] != nil }
+      out += (supers[usr] ?? []).filter { syms[$0] != nil }
+      if typeKinds.contains(s.kind) {
+        for m in members[usr] ?? [] {
+          guard let ms = syms[m] else { continue }
+          if allMemberKinds.contains(s.kind) || layoutMemberKinds.contains(ms.kind) { out.append(m) }
+        }
+      }
+      return out
+    }
+
+    // Digest of each strongly connected component, successors first (Tarjan).
+    let order = syms.keys.sorted()
